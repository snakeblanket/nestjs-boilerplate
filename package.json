{
  "name": "nestjs-boilerplate",
  "version": "0.1.0",
  "description": "NestJS + Fastify boilerplate (standard code style)",
  "private": true,
  "scripts": {
    "build": "bunx prisma generate && bunx nest build",
    "start": "bunx nest start",
    "start:dev": "bunx nest start --watch",
    "start:prod": "bun dist/src/main",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "lint": "bunx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun x jest",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^5.1.1",
    "git-rev-sync": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pem-jwk": "^2.0.0",
    "pg": "^8.13.1",
    "prisma": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "useragent": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/useragent": "^2.3.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
