# Database (Prisma + pg adapter)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Service
SERVICE_PORT=3001
NODE_ENV=development

# CORS allowed origins (comma separated). No domain hardcoding in source.
CORS_ORIGINS=http://localhost:5173

# JWT
JWT_ISSUER=api

# Scanner block / in-app fail2ban
SCANNER_BAN_THRESHOLD=8
SCANNER_BAN_WINDOW_MS=60000
SCANNER_BAN_DURATION_MS=3600000
SCANNER_BLOCK_DISABLED=false
