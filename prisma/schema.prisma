generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  HEAD
  OPTIONS
}

enum UserRole {
  USER
  ADMIN
  S_ADMIN
  SERVICE
}

model User {
  id            Int            @id @default(autoincrement())
  uuid          String         @unique @default(uuid()) @db.Uuid
  username      String?        @unique @db.VarChar(255)
  name          String         @db.VarChar(255)
  email         String?        @unique @db.VarChar(255)
  password      String         @db.VarChar(255)
  phone         String?        @db.VarChar(50)
  role          UserRole       @default(USER)
  is_active     Boolean        @default(true)
  profile_image String?        @db.VarChar(512)

  refresh_tokens RefreshToken[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@map("user")
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid()) @db.Uuid
  user_uuid    String    @db.Uuid
  user         User      @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  token        String    @db.Text
  expires_at   DateTime  @db.Timestamptz(6)
  ip           String?   @db.VarChar(255)
  user_agent   String?   @db.Text
  loc_country  String?   @db.VarChar(255)
  loc_region   String?   @db.VarChar(255)
  loc_city     String?   @db.VarChar(255)
  last_seen_at DateTime? @db.Timestamptz(6)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@map("refresh_token")
}

model Request {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid()) @db.Uuid
  ip            String
  user_agent    Json
  method        RequestMethod
  host          String?       @db.VarChar(255)
  url           String?       @db.VarChar(255)
  body          Json?
  query         Json?
  params        String?
  headers       String?
  cookies       String?
  response_body Json?
  error         String?
  status        Int?
  duration      Int?
  request_at  DateTime  @default(now()) @db.Timestamptz(6)
  response_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  @@map("request")
}
